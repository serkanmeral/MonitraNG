[Unit]
Description=MngLogs Agent (MonitraNG)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mnglogs/agent
ExecStart=/opt/mnglogs/agent/MngLogs.Agent
Restart=on-failure
RestartSec=5
User=root
# Prefer EnvironmentFile for site-specific overrides (optional):
# EnvironmentFile=-/etc/mnglogs/agent/agent.env
# KillMode=process keeps Local UI child behavior predictable.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
