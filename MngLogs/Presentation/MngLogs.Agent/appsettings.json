{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "MngLogsAgentSettings": {
    "System": {
      "CollectorBaseUrl": "http://127.0.0.1:5091",
      "ApiKey": "",
      "HostId": "",
      "LocalUiHost": "127.0.0.1",
      "LocalUiPort": 5092,
      "DataDirectory": ""
    },
    "Policy": {
      "Domain": "odak",
      "HeartbeatIntervalSeconds": 60,
      "ShipIntervalSeconds": 5,
      "MaxEventsPerBatch": 100,
      "Metrics": {
        "Enabled": true,
        "IncludeHostResources": true,
        "IncludeTopProcesses": true,
        "TopProcessCount": 5
      },
      "EventLog": {
        "Enabled": true,
        "PollIntervalSeconds": 10,
        "MaxEventsPerPoll": 50,
        "Packages": []
      },
      "ServiceWatch": {
        "Enabled": true,
        "PollIntervalSeconds": 15,
        "Services": []
      }
    }
  }
}
