{
  "_comment": "Kopyala: appsettings.Development.json — Odak. Seq: @Message like '%DirectorySync%'",
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "MngKeeper": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://192.168.20.20:5341",
          "apiKey": null,
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentUserName"],
    "Properties": {
      "Application": "MngKeeper.Api",
      "Environment": "Development"
    }
  },
  "Seq": {
    "ServerUrl": "http://192.168.20.20:5341",
    "ApiKey": null,
    "MinimumLevel": "Debug"
  },
  "MngKeeperSettings": {
    "DirectorySync": {
      "LoginSyncEnabled": true
    },
    "OpenApiServerPath": "http://localhost:5001",
    "MongoDB": {
      "ConnectionString": "mongodb://admin:admin123@192.168.20.20:27017",
      "DatabaseName": "mngkeeper"
    },
    "Keycloak": {
      "BaseUrl": "http://192.168.20.20:8080",
      "PathPrefix": "/keycloak",
      "AdminUsername": "admin",
      "AdminPassword": "Odak@Infra2026!",
      "ClientId": "admin-cli",
      "ClientSecret": "",
      "DefaultAdminPassword": "Odak@Infra2026!"
    },
    "Redis": {
      "ConnectionString": "192.168.20.20:6379,password=Odak@Infra2026!,abortConnect=false"
    },
    "MinIO": {
      "Endpoint": "192.168.20.20:9090",
      "AccessKey": "admin",
      "SecretKey": "Odak@Infra2026!",
      "UseSSL": false
    }
  }
}
