{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "MngDataGateway": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "apiKey": null,
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentUserName"],
    "Properties": {
      "Application": "MngDataGateway.Api",
      "Environment": "Development",
      "Version": "1.0.0"
    }
  },
  "AllowedHosts": "*",
  "MngDataGatewaySettings": {
    "Server": {
      "Host": "0.0.0.0",
      "Port": 5010,
      "Scheme": "https"
    },
    "OpenApiServerPath": "https://api.monitra.local/data",
    "MongoDB": {
      "ConnectionString": "mongodb://admin:admin123@localhost:27017"
    },
    "Actors": {
      "MngKeeper": "https://localhost:5040/keeper"
    },
    "History": {
      "MaxHistoryEntries": 50
    },
    "DeletedData": {
      "RetentionDays": 7
    },
    "Query": {
      "RelationExpansionMaxDepth": 2,
      "DefaultPageSize": 50,
      "MaxPageSize": 1000
    },
    "Validation": {
      "HttpValidationTimeout": 30
    },
    "CertificateSettings": {
      "DNS": "",
      "MNG_CERT_FILE": "cert.crt",
      "MNG_KEY_FILE": "cert.key",
      "MNG_CERT_FILE_CONTENT": "",
      "MNG_KEY_FILE_CONTENT": ""
    },
    "RabbitMQ": {
      "Host": "localhost",
      "Port": 5672,
      "Username": "admin",
      "Password": "admin123",
      "VirtualHost": "/"
    },
    "FileStorage": {
      "Minio": {
        "Endpoint": "minio:9000",
        "AccessKey": "admin",
        "SecretKey": "admin123",
        "BucketName": "datasets",
        "UseSSL": false
      },
      "Encryption": {
        "Enabled": true,
        "Algorithm": "AES-256-GCM",
        "Key": "MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=",
        "KeyDerivation": "PBKDF2",
        "Iterations": 10000,
        "SaltLength": 16
      },
      "Compression": {
        "Algorithm": "gzip",
        "Level": 6,
        "Enabled": true
      },
      "Validation": {
        "MaxFileSize": 5242880,
        "AllowedMimeTypes": [],
        "AllowedExtensions": [],
        "FolderPathPattern": "^[a-zA-Z0-9_\\-/]+$"
      },
      "Retry": {
        "MaxAttempts": 3,
        "InitialDelayMs": 1000,
        "MaxDelayMs": 10000,
        "BackoffMultiplier": 2.0
      }
    }
  }
}
