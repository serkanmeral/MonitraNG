{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "MngDataGateway": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "apiKey": null,
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentUserName"],
    "Properties": {
      "Application": "MngDataGateway.Api",
      "Environment": "Development",
      "Version": "1.0.0"
    }
  },
  "AllowedHosts": "*",
  "MngDataGatewaySettings": {
    "Server": {
      "Host": "0.0.0.0",
      "Port": 5010,
      "Scheme": "https"
    },
    "OpenApiServerPath": "https://localhost:5010",
    "MongoDB": {
      "ConnectionString": "mongodb://admin:admin123@localhost:27017"
    },
    "Actors": {
      "MngKeeper": "https://localhost:5001"
    },
    "History": {
      "MaxHistoryEntries": 50
    },
    "DeletedData": {
      "RetentionDays": 7
    },
    "CertificateSettings": {
      "DNS": "",
      "MNG_CERT_FILE": "cert.crt",
      "MNG_KEY_FILE": "cert.key",
      "MNG_CERT_FILE_CONTENT": "",
      "MNG_KEY_FILE_CONTENT": ""
    },
    "RabbitMQ": {
      "Host": "localhost",
      "Port": 5672,
      "Username": "admin",
      "Password": "admin123",
      "VirtualHost": "/"
    }
  }
}
