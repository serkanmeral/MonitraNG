{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "MngDocument": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "MngDocument.Api",
      "Environment": "Development"
    }
  },
  "AllowedHosts": "*",
  "EnableSwagger": true,
  "Jwt": {
    "Authority": "",
    "RequireHttpsMetadata": false
  },
  "MngDocumentSettings": {
    "Server": {
      "Host": "0.0.0.0",
      "Port": 5095,
      "Scheme": "http"
    },
    "OpenApiServerPath": "https://api.monitra.local/documents",
    "DataGateway": {
      "BaseUrl": "http://mngdatagateway:5010",
      "ApiVersion": "v1"
    },
    "Resources": {
      "MaxMarkdownContentLength": 1000000,
      "MaxTreeNodes": 5000
    },
    "DocumentRendering": {
      "Enabled": true,
      "GotenbergBaseUrl": "http://gotenberg:3000",
      "TimeoutSeconds": 120
    },
    "Collabora": {
      "Enabled": false,
      "PublicBaseUrl": "http://localhost:9980",
      "EditorPath": "/browser/dist/cool.html",
      "PostMessageOrigin": "http://localhost:3000 http://127.0.0.1:3000"
    },
    "Wopi": {
      "HostBaseUrl": "http://mngdocument:5095",
      "SessionMinutes": 480
    },
    "EditorLimits": {
      "MaxConcurrentConnections": 18,
      "MaxConcurrentDocuments": 9,
      "MaxSessionsPerUser": 3,
      "IdleTimeoutMinutes": 30,
      "EnforceLimits": true,
      "CollaboraMaxConnections": 20,
      "CollaboraMaxDocuments": 10
    },
    "EditorLock": {
      "WarnOnActiveEditor": true,
      "EnforceExclusiveLock": true,
      "AllowManagerBypass": true,
      "BlockSameUserDuplicateSession": true
    },
    "Keeper": {
      "BaseUrl": "http://mngkeeper:5001"
    },
    "FooterProfile": {
      "FormCode": "F86",
      "FormRevision": "Rev04",
      "FormRevisionDate": "30.11.2022",
      "Offices": [
        {
          "Label": "Merkez Ofis",
          "Address": "Cinnah Caddesi No:11/5 06690 Çankaya – Ankara/TÜRKİYE",
          "Phone": "+90 312 466 19 22",
          "Fax": "+90 312 426 85 14"
        },
        {
          "Label": "Üretim",
          "Address": "Ostim OSB Mh. 1227 Cd. No: 6/C 06374 Ostim -Ankara-/TÜRKİYE",
          "Phone": "+90 312 354 90 81",
          "Fax": "+90 312 354 90 82"
        }
      ]
    },
    "Notifications": {
      "Enabled": false,
      "NotifierBaseUrl": "http://mngnotifier:5070",
      "NotifierApiVersion": "v1",
      "Channels": [ "email" ],
      "DefaultTo": [],
      "DefaultTelegramChatIds": [],
      "TelegramUserIds": [],
      "DomainId": "",
      "KeeperBaseUrl": "http://mngkeeper:5001",
      "InternalNotifyApiKey": "",
      "UiBaseUrl": "http://localhost:3000",
      "DeepLinkPathTemplate": "/apps/document-intelligence/r/{id}"
    },
    "DocumentGeneration": {
      "Profiles": [
        {
          "Code": "odak.coc.fromLine",
          "TemplateCode": "COC-STANDARD",
          "ContextType": "odak.siparis.line",
          "OutputFolderPath": ["Odak", "CoC", "{workPackageNo}"],
          "FileNamePattern": "{poDocNo}-{workPackageNo}-K{lineNo}.docx",
          "Idempotency": {
            "Dataset": "odak_siparis_kalemleri",
            "GuardField": "cocDiResourceId",
            "WritebackFields": ["cocDiResourceId", "cocDocNo", "cocGeneratedAt", "cocTemplateCode", "cocTemplateName"]
          },
          "Defaults": {
            "documentName": "Uygunluk Belgesi",
            "signatoryName": "GİZEM CANDAŞ",
            "signatoryTitle": "KALİTE KONTROL YÖNETİCİSİ"
          }
        },
        {
          "Code": "odak.line.activity.fromLine",
          "TemplateCode": "LINE-ACTIVITY-STD",
          "ContextType": "odak.siparis.line",
          "OutputFolderPath": ["Odak", "Activity", "{workPackageNo}"],
          "FileNamePattern": "{poDocNo}-{workPackageNo}-K{lineNo}.docx",
          "Idempotency": {
            "Dataset": "odak_siparis_kalemleri",
            "WritebackFields": ["activityDiResourceId", "activityDocNo", "activityGeneratedAt", "activityTemplateCode", "activityTemplateName"]
          },
          "Defaults": {
            "documentName": "Kalem Activity Raporu"
          }
        }
      ]
    }
  }
}
