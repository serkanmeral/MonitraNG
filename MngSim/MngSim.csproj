<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MngSim</RootNamespace>
    <Version>1.0.0</Version>
    <!-- dotnet watch ile train-map / API kullanırken BrowserRefresh middleware sıkıştırma hatası veriyor; kapatıyoruz -->
    <DotnetWatchSuppressBrowserRefresh>true</DotnetWatchSuppressBrowserRefresh>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lextm.SharpSnmpLib" Version="12.5.7" />
    <PackageReference Include="MQTTnet" Version="5.0.0.1405" />
    <PackageReference Include="RestSharp" Version="113.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\TrainSim\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
