{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "MngAlarmSettings": {
    "MongoDb": {
      "ConnectionString": "mongodb://admin:admin123@localhost:27017",
      "DatabasePrefix": "mng_"
    },
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "Username": "admin",
      "Password": "admin123"
    },
    "Engine": {
      "ObservationPrefetch": 16,
      "ConsumeObservations": false
    }
  },
  "EnableDevAlarmEndpoints": true,
  "EnableSwagger": false,
  "Jwt": {
    "Authority": ""
  }
}
