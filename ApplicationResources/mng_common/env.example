# Environment Variables Example
# Copy this file to .env and update the values
# DO NOT commit .env file to repository

# Default Password for All Services
# Test environment - all services use the same password value
# Production environments should use different passwords per service

# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_INITDB_DATABASE=mngkeeper

# MongoDB Express (Web UI)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=CHANGE_ME

# Keycloak (zorunlu — .env'de tanımlı olmalı; yoksa container başlamaz)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# PostgreSQL (for Keycloak — Keycloak bunlarla DB'ye bağlanır)
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_PASSWORD=CHANGE_ME

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME

# Seq (Logging)
SEQ_ADMIN_PASSWORD=CHANGE_ME

# Node-RED
NODE_RED_USERNAME=admin
NODE_RED_PASSWORD=CHANGE_ME

# Mosquitto MQTT Broker (MngReactor, MngKeeper, MngSim vb. servislerin Mosquitto'ya baglanmasi icin)
# mosquitto/config/passwd dosyasindaki kullanici/sifre ile uyumlu olmali (bkz. docs/content/infrastructure/MOSQUITTO_CREDENTIALS.md)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=monitrang
MQTT_PASSWORD=!2345qawsedrf

# Note: GitLab services (gitlab-postgres, gitlab-redis, gitlab) are excluded
# They use their own passwords and should not be changed

