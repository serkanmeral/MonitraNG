{
  "policy": {
    "description": "MonitraNG SIEM metrics — delete after 30 days (default; override via config later)",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": { "min_index_age": "30d" }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [{ "delete": {} }]
      }
    ],
    "ism_template": [
      {
        "index_patterns": ["mng-*-metrics*"],
        "priority": 110
      }
    ]
  }
}
