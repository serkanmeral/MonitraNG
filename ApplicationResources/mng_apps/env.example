# Environment
ENVIRONMENT=Production
# veya Test için: ENVIRONMENT=Test

# Version
VERSION=latest

# Domain
DOMAIN=monitrang.com
# Test için: DOMAIN=test.monitrang.com

# OpenAPI Server Path
OPENAPI_SERVER_PATH=https://monitrang.com
# Test için: OPENAPI_SERVER_PATH=https://test.monitrang.com

# MongoDB
MONGO_CONNECTION_STRING=mongodb://admin:CHANGE_ME@mongo:27017
MONGO_DATABASE_NAME=mngkeeper
# MngReactor icin (ConnectionString yerine ayri alanlar kullanilir)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=CHANGE_ME

# Keycloak (MngKeeper Create Domain + admin token için gerekli)
# BaseUrl sadece origin olmalı; path prefix ayrı verilir. Keycloak /keycloak altındaysa KEYCLOAK_PATH_PREFIX=/keycloak kullanın.
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_PATH_PREFIX=/keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_CLIENT_ID=mng-keeper-admin
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_DEFAULT_ADMIN_PASSWORD=CHANGE_ME

# Redis
REDIS_CONNECTION_STRING=redis:6379,password=CHANGE_ME

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VIRTUALHOST=/

# MQTT
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=monitrang
MQTT_PASSWORD=CHANGE_ME
MQTT_TOPIC_PREFIX=MNG

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# CORS (MngGateway + MngHub)
# Tarayıcıdan erişen frontend origin'leri. MngGateway ve MngHub ikisi de bu değişkenleri kullanır.
# Örnek: https://app.monitrang.com — ikinci origin gerekiyorsa CORS_ALLOWED_ORIGIN_2 tanımlayın.
CORS_ALLOWED_ORIGIN_1=https://app.monitra.local
# CORS_ALLOWED_ORIGIN_2=

# MngKeeper – License MasterKey (Create Domain / trial lisans şifrelemesi için zorunlu)
# En az 32 karakter; üretmek için: openssl rand -base64 32
# Repo/ dokümana gerçek değeri yazmayın; sunucuda .env içinde saklayın.
# MNGKEEPER_LICENSE_MASTER_KEY=

# MngNotifier – Mail (SMTP)
# Sunucuda test mail scripti ile aynı ayarlar (127.0.0.1:25, noreply@monitrang.com).
# Container içinden host SMTP'ye erişim:
#   - host.docker.internal (compose'ta extra_hosts gerekir; bazen Linux'ta çözülmez)
#   - Linux'ta "Name or service not known" alırsanız: SMTP_HOST=172.17.0.1 veya gateway IP
# Gateway IP bulmak (sunucuda): docker run --rm --network mng_common_mng_network alpine ip route | awk '/default/ {print $3}'
SMTP_HOST=host.docker.internal
# Linux'ta "Name or service not known" alırsanız: SMTP_HOST=172.17.0.1 veya yukarıdaki komutla bulduğunuz IP
SMTP_PORT=25
SMTP_FROM_EMAIL=noreply@monitrang.com
SMTP_FROM_NAME=MonitraNG
# SMTP auth (Mailu yerel relay için genelde boş)
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Application URLs
MNGKEEPER_URL=https://mngkeeper:5001
# Engine host'ta çalışıyorsa config string tokenUrl için (Engine mngkeeper:5001'e erişemez):
# Gateway arkasında: MNGKEEPER_ENGINE_URL=https://localhost:5040/keeper  → tokenUrl: .../keeper/api/auth/token
# Keeper direkt:     MNGKEEPER_ENGINE_URL=http://localhost:5001
# (Engine self-signed SSL hatası vermez)
MNGKEEPER_ENGINE_URL=https://localhost:5040/keeper
MNGDATAGATEWAY_URL=https://mngdatagateway:5010
# MngDataGateway → MngNotifier (cht_messages mention MVP; docker-compose.production: MngDataGatewaySettings__Actors__MngNotifier)
MNGNOTIFIER_URL=http://mngnotifier:5070
# DG + Notifier chat-mention için ortak gizli anahtar (boş = doğrulama yok). Her iki serviste INTERNAL_NOTIFY_API_KEY aynı olmalı.
# INTERNAL_NOTIFY_API_KEY=
MNGREACTOR_URL=http://mngreactor:5003
# Engine host'ta çalışıyorsa config string serverUrl için (Reactor Gateway arkasında):
# MNGREACTOR_ENGINE_URL=https://localhost:5040/reactor
MNGREACTOR_ENGINE_URL=
MNGHUB_URL=http://mnghub:5020
# MngWorkflow (Gateway: /workflow/api/v1/...; Swagger: https://.../workflow/swagger)
# Container: ENABLE_WORKFLOW_SWAGGER=true → Production’da bile Swagger (güvenilir ortamlarda).
MNGWORKFLOW_URL=http://mngworkflow:5085
# ENABLE_WORKFLOW_SWAGGER=false

# MngKeeper – Notifier (şifre sıfırlama / e-posta; Keeper → MngNotifier)
# Container içinden: http://mngnotifier:5070 (compose varsayılanı)
# NOTIFIER_BASE_URL=http://mngnotifier:5070
# NOTIFIER_API_VERSION=v1

# MngKeeper – UI base URL (şifre sıfırlama mailindeki link)
# Production: https://app.monitrang.com — maildeki link bu adrese yönlendirir
MNG_KEEPER_UI_BASE_URL=https://app.monitrang.com

# MngLLM – JWT Authority (çoğu kurulumda boş bırakın).
# Token MngKeeper’dan gelir; domain_name token içinden okunur (DG ile aynı). Realm değişkendir.
# Bu yüzden varsayılan boş: Authority set edilmez, imza doğrulaması yapılmaz, sadece token parse edilir.
# Sadece belirli bir Keycloak realm’e göre sıkı doğrulama isterseniz tanımlayın:
# MNGLLM_JWT_AUTHORITY=http://keycloak:8080/keycloak/realms/REALM_ADI

# UI Configuration
UI_PORT=3000
GATEWAY_URL=
KEEPER_URL=https://mngkeeper:5001
DATAGATEWAY_URL=https://mngdatagateway:5010
HUB_URL=http://mnghub:5020

# GeoServer (Mng.Ui harita — çevrimdışı altlık)
# Tanımlıysa Monitoring > Harita sayfasında "GeoServer arka plan" seçeneği açılır.
# GEOSERVER_BASE_URL container'dan GeoServer'a erişim URL'si (örn. http://geoserver:8080 veya host üstünden http://host.docker.internal:8082)
# GEOSERVER_BASE_URL=http://geoserver:8080
# Opsiyonel: WMTS tile matrix set (varsayılan EPSG:900913). Sadece EPSG:3857 varsa: GEOSERVER_TILE_MATRIX_SET=EPSG:3857
# GEOSERVER_TILE_MATRIX_SET=EPSG:900913
# Opsiyonel: Grid subset sınırlıysa ofset (bkz. mng_others/GEOSERVER_GRIDSET_EPSG3857.md)
# GEOSERVER_TILE_COL_OFFSET=0
# GEOSERVER_TILE_ROW_OFFSET=0

# Certificate DNS
CERTIFICATE_DNS=mngkeeper

