# Environment
ENVIRONMENT=Production
# veya Test için: ENVIRONMENT=Test

# Version
VERSION=latest

# Domain
DOMAIN=monitrang.com
# Test için: DOMAIN=test.monitrang.com

# OpenAPI Server Path
OPENAPI_SERVER_PATH=https://monitrang.com
# Test için: OPENAPI_SERVER_PATH=https://test.monitrang.com

# MongoDB
MONGO_CONNECTION_STRING=mongodb://admin:CHANGE_ME@mongo:27017
MONGO_DATABASE_NAME=mngkeeper

# Keycloak (MngKeeper Create Domain + admin token için gerekli)
# BaseUrl sadece origin olmalı; path prefix ayrı verilir. Keycloak /keycloak altındaysa KEYCLOAK_PATH_PREFIX=/keycloak kullanın.
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_PATH_PREFIX=/keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_CLIENT_ID=mng-keeper-admin
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_DEFAULT_ADMIN_PASSWORD=CHANGE_ME

# Redis
REDIS_CONNECTION_STRING=redis:6379,password=CHANGE_ME

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VIRTUALHOST=/

# MQTT
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=monitrang
MQTT_PASSWORD=CHANGE_ME
MQTT_TOPIC_PREFIX=MNG

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# CORS (MngGateway + MngHub)
# Tarayıcıdan erişen frontend origin'leri. MngGateway ve MngHub ikisi de bu değişkenleri kullanır.
# Örnek: https://app.monitrang.com — ikinci origin gerekiyorsa CORS_ALLOWED_ORIGIN_2 tanımlayın.
CORS_ALLOWED_ORIGIN_1=https://app.monitra.local
# CORS_ALLOWED_ORIGIN_2=

# MngKeeper – License MasterKey (Create Domain / trial lisans şifrelemesi için zorunlu)
# En az 32 karakter; üretmek için: openssl rand -base64 32
# Repo/ dokümana gerçek değeri yazmayın; sunucuda .env içinde saklayın.
# MNGKEEPER_LICENSE_MASTER_KEY=

# Application URLs
MNGKEEPER_URL=https://mngkeeper:5001
MNGDATAGATEWAY_URL=https://mngdatagateway:5010
MNGHUB_URL=http://mnghub:5020

# MngLLM – JWT Authority (çoğu kurulumda boş bırakın).
# Token MngKeeper’dan gelir; domain_name token içinden okunur (DG ile aynı). Realm değişkendir.
# Bu yüzden varsayılan boş: Authority set edilmez, imza doğrulaması yapılmaz, sadece token parse edilir.
# Sadece belirli bir Keycloak realm’e göre sıkı doğrulama isterseniz tanımlayın:
# MNGLLM_JWT_AUTHORITY=http://keycloak:8080/keycloak/realms/REALM_ADI

# UI Configuration
UI_PORT=3000
GATEWAY_URL=
KEEPER_URL=https://mngkeeper:5001
DATAGATEWAY_URL=https://mngdatagateway:5010
HUB_URL=http://mnghub:5020

# Certificate DNS
CERTIFICATE_DNS=mngkeeper

