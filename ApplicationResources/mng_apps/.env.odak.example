# Odak — mng_common ile hizalı (192.168.20.20)
# Sunucuda: cp .env.odak.example .env && KEYCLOAK_CLIENT_SECRET + MNGKEEPER_LICENSE_MASTER_KEY doldurun

ENVIRONMENT=Production
VERSION=latest
DOMAIN=192.168.20.20
OPENAPI_SERVER_PATH=http://192.168.20.20:5040

MONGO_CONNECTION_STRING=mongodb://admin:admin123@mongo:27017/?authSource=admin
MONGO_DATABASE_NAME=mngkeeper
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=admin123

# mng_common ile aynı — MngAdmin PostgreSQL backup (keycloak DB)
POSTGRES_PASSWORD=Odak@Infra2026!

KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_PATH_PREFIX=/keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=Odak@Infra2026!
KEYCLOAK_CLIENT_ID=mng-keeper-admin
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_AFTER_KEYCLOAK_CLIENT_SETUP
KEYCLOAK_DEFAULT_ADMIN_PASSWORD=Odak@Infra2026!

REDIS_CONNECTION_STRING=redis:6379,password=Odak@Infra2026!

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=Odak@Infra2026!
RABBITMQ_VIRTUALHOST=/

MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=monitrang
MQTT_PASSWORD=!2345qawsedrf
MQTT_TOPIC_PREFIX=MNG

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=Odak@Infra2026!
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

CORS_ALLOWED_ORIGIN_1=http://192.168.20.20:3000

# openssl rand -base64 32 ile üretin; örnek (değiştirin):
MNGKEEPER_LICENSE_MASTER_KEY=OdakKeeperLicenseMasterKey2026!!

MNGKEEPER_URL=http://mngkeeper:5001
MNGKEEPER_ENGINE_URL=http://192.168.20.20:5001
MNGDATAGATEWAY_URL=http://mngdatagateway:5010
MNGNOTIFIER_URL=http://mngnotifier:5070
MNGREACTOR_URL=http://mngreactor:5003
MNGHUB_URL=http://mnghub:5020
MNGWORKFLOW_URL=http://mngworkflow:5085

SMTP_HOST=172.17.0.1
SMTP_PORT=25
SMTP_FROM_EMAIL=noreply@odak.local
SMTP_FROM_NAME=MonitraNG Odak

MNG_KEEPER_UI_BASE_URL=http://192.168.20.20:3000

GATEWAY_URL=http://192.168.20.20:5040
KEEPER_URL=http://192.168.20.20:5001
DATAGATEWAY_URL=http://192.168.20.20:5010
HUB_URL=http://192.168.20.20:5020

UI_PORT=3000
CERTIFICATE_DNS=mnggateway
JWT_REQUIRE_HTTPS_METADATA=false

SERVER_KEEPER_URL=http://mngkeeper:5001
SERVER_DATAGATEWAY_URL=http://mngdatagateway:5010
SERVER_HUB_URL=http://mnghub:5020
SERVER_SCHEDULER_URL=http://mngscheduler:5090
MNGOPERATIONS_URL=http://mngoperations:5086

# Operation Core — zamanlanmış WI (MngScheduler → Keeper token → MO)
OC_SCHEDULER_WI_ENABLED=true
OC_SCHEDULER_DOMAIN=odak
OC_SCHEDULER_USERNAME=odak_admin
OC_SCHEDULER_PASSWORD=Admin123!
OC_SCHEDULER_MO_FROM_ORIGIN=http://mnggateway:5000/operations/api/v1/work-items/from-origin
# User job Quartz senkronu (OC oc-schedule-* job'ları için odak_admin JWT ile DG okuma)
OC_SCHEDULER_SYNC_USER_JOBS=true
