# Fatih Home — mng_apps (.env). mng_common CREDENTIALS ile hizalı.
# Sunucuda: cp .env.fatih.example .env
# KEYCLOAK_CLIENT_SECRET ve MNGKEEPER_LICENSE_MASTER_KEY sunucuda doldurulur (git'e gerçek değer yazmayın).

ENVIRONMENT=Production
VERSION=latest
DOMAIN=10.0.10.52
OPENAPI_SERVER_PATH=http://10.0.10.52:5040

MONGO_CONNECTION_STRING=mongodb://admin:admin123@mongo:27017/?authSource=admin
MONGO_DATABASE_NAME=mngkeeper
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=admin123

POSTGRES_PASSWORD=keycloak123

KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_PATH_PREFIX=/keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_CLIENT_ID=mng-keeper-admin
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_AFTER_KEYCLOAK_CLIENT_SETUP
KEYCLOAK_DEFAULT_ADMIN_PASSWORD=admin123

REDIS_CONNECTION_STRING=redis:6379,password=redis123

