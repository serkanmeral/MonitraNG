{
  "_comment": "Kopyala: appsettings.Development.json — Odak. Seq filtre örneği: Application = 'MngScheduler.Api' && MessageTemplate like '%DirectorySync%'",
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "MngScheduler": "Debug",
        "Quartz": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://192.168.20.20:5341",
          "apiKey": null,
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentUserName"],
    "Properties": {
      "Application": "MngScheduler.Api",
      "Environment": "Development"
    }
  },
  "Seq": {
    "ServerUrl": "http://192.168.20.20:5341",
    "ApiKey": null,
    "MinimumLevel": "Debug"
  },
  "MngSchedulerSettings": {
    "MongoDB": {
      "ConnectionString": "mongodb://admin:admin123@192.168.20.20:27017",
      "KeeperDatabaseName": "mngkeeper"
    },
    "Actors": {
      "MngKeeper": "http://192.168.20.20:5001"
    },
    "RabbitMQ": {
      "Host": "192.168.20.20",
      "Port": 5672,
      "Username": "admin",
      "Password": "Odak@Infra2026!",
      "VirtualHost": "/"
    },
    "JobSync": {
      "SyncIntervalSeconds": 30,
      "Enabled": true,
      "SyncUserJobs": false
    },
    "DirectorySyncOrchestration": {
      "Enabled": true,
      "MngKeeperBaseUrl": "http://192.168.20.20:5001",
      "ContinueOnDomainError": true,
      "UseDomainNameAsRealm": true
    }
  }
}
