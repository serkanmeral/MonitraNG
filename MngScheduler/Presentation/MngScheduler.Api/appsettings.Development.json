{
  "_comment": "Yerel dotnet run — Odak altyapı. Seq: http://192.168.20.20:5341 — filtre: Application = 'MngScheduler.Api' && DirectorySync",
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "MngScheduler": "Debug",
        "Quartz": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://192.168.20.20:5341",
          "apiKey": null,
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentUserName"],
    "Properties": {
      "Application": "MngScheduler.Api",
      "Environment": "Development"
    }
  },
  "Seq": {
    "ServerUrl": "http://192.168.20.20:5341",
    "ApiKey": null,
    "MinimumLevel": "Debug"
  },
  "MngSchedulerSettings": {
    "MongoDB": {
      "ConnectionString": "mongodb://admin:admin123@192.168.20.20:27017",
      "KeeperDatabaseName": "mngkeeper"
    },
    "Actors": {
      "MngKeeper": "http://192.168.20.20:5001",
      "MngOperations": "http://192.168.20.20:5040/operations"
    },
    "RabbitMQ": {
      "Host": "192.168.20.20",
      "Port": 5672,
      "Username": "admin",
      "Password": "Odak@Infra2026!",
      "VirtualHost": "/"
    },
    "DirectorySyncOrchestration": {
      "Enabled": true,
      "MngKeeperBaseUrl": "http://192.168.20.20:5001",
      "ContinueOnDomainError": true,
      "UseDomainNameAsRealm": true
    },
    "WorkItemScheduleOrchestration": {
      "Enabled": true,
      "MngKeeperBaseUrl": "http://192.168.20.20:5001",
      "KeeperTokenPath": "/api/auth/token",
      "GatewayOperationsFromOrigin": "http://192.168.20.20:5040/operations/api/v1/work-items/from-origin",
      "ExecuteEndpointTemplate": "http://192.168.20.20:5086/api/v1/work-item-schedules/{scheduleId}/execute",
      "ServiceAccount": {
        "DomainName": "odak",
        "Username": "odak_admin",
        "Password": "Admin123!"
      }
    }
  }
}
