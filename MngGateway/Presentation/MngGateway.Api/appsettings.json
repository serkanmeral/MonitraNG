{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Information"
    }
  },
  "AllowedHosts": "*",
  "MngGatewaySettings": {
    "Server": {
      "Host": "0.0.0.0",
      "Port": 5000,
      "Scheme": "https"
    },
    "Jwt": {
      "Authority": "http://keycloak:8080/realms/monitra",
      "Audience": "account",
      "RequireHttpsMetadata": false
    },
    "Cors": {
      "AllowedOrigins": [
        "https://app.monitra.local",
        "http://localhost:3000"
      ],
      "AllowCredentials": true
    },
    "RateLimit": {
      "EnableRateLimiting": true,
      "AnonymousLimit": 30,
      "AuthenticatedLimit": 100,
      "AdminLimit": 500,
      "Period": "1m"
    },
    "CertificateSettings": {
      "DNS": "mnggateway"
    },
    "OpenApiServerPath": "https://api.monitra.local",
    "BackendServices": {
      "MngKeeper": "http://mngkeeper:5001",
      "MngDataGateway": "http://mngdatagateway:5010",
      "MngHub": "http://mnghub:5020",
      "MngReactor": "http://mngreactor:5003",
      "MngWorkflow": "http://mngworkflow:5085",
      "MngAlarm": "http://mngalarm:5087",
      "MngOperations": "http://mngoperations:5086",
      "KeyCloak": "http://keycloak:8080"
    }
  }
}
