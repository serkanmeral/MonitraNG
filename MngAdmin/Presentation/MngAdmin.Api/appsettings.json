{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "MngAdmin": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "apiKey": null,
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentUserName"],
    "Properties": {
      "Application": "MngAdmin.Api",
      "Environment": "Development",
      "Version": "1.0.0"
    }
  },
  "AllowedHosts": "*",
  "MngAdminSettings": {
    "Server": {
      "Host": "0.0.0.0",
      "Port": 5080,
      "Scheme": "https"
    },
    "OpenApiServerPath": "https://api.monitra.local/admin",
    "MongoDB": {
      "ConnectionString": "mongodb://admin:admin123@localhost:27017"
    },
    "Actors": {
      "MngKeeper": "http://localhost:5001"
    },
    "RabbitMQ": {
      "Host": "localhost",
      "Port": 5672,
      "Username": "admin",
      "Password": "admin123",
      "VirtualHost": "/"
    },
    "CertificateSettings": {
      "DNS": "",
      "MNG_CERT_FILE": "cert.crt",
      "MNG_KEY_FILE": "cert.key",
      "MNG_CERT_FILE_CONTENT": "",
      "MNG_KEY_FILE_CONTENT": ""
    },
    "Backup": {
      "MaxBackupCount": 10,
      "MinIO": {
        "SystemBucket": "system",
        "SystemBackupPath": "backup",
        "DomainBackupPath": "backups"
      },
      "MongoDB": {
        "Compression": "zip",
        "IncludeSystemCollections": false
      },
      "PostgreSQL": {
        "Compression": "gzip",
        "Databases": ["keycloak"]
      }
    },
    "MinIO": {
      "Endpoint": "localhost:9090",
      "AccessKey": "admin",
      "SecretKey": "admin123",
      "UseSSL": false,
      "Region": "us-east-1"
    }
  }
}
