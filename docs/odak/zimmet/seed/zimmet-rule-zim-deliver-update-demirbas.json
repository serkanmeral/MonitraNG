{
  "name": "Personel Zimmet — Teslimde demirbas zimmetle",
  "workspaceId": "{{wsZimId}}",
  "ruleType": "automation",
  "trigger": "WorkItemTransitioned",
  "isActive": true,
  "priority": 100,
  "typeId": "{{typeZimmetVermeId}}",
  "transitionKey": "deliver",
    "actions": [
    {
      "type": "createDatasetRows",
      "dataset": "zimmet_demirbas_hareketleri",
      "onError": "failTransition",
      "cardinality": {
        "mode": "expand",
        "itemsFrom": "fields.demirbasIds",
        "itemAs": "id"
      },
      "idempotency": {
        "mode": "one_per_source",
        "lookupField": "isRef",
        "lookupFrom": "key"
      },
      "fieldMappings": [
        { "target": "demirbasId", "source": "item", "path": "value" },
        { "target": "olay", "source": "static", "value": "zimmetlendi" },
        { "target": "personelId", "source": "field", "path": "fields.personelId" },
        { "target": "tarih", "source": "field", "path": "fields.teslimTarihi" },
        { "target": "isRef", "source": "field", "path": "key" }
      ]
    },
    {
      "type": "updateDatasetRows",
      "dataset": "zimmet_demirbaslar",
      "onError": "failTransition",
      "cardinality": {
        "mode": "expand",
        "itemsFrom": "fields.demirbasIds",
        "itemAs": "id"
      },
      "targetId": {
        "source": "item",
        "path": "value"
      },
      "fieldMappings": [
        { "target": "durum", "source": "static", "value": "zimmetli" },
        { "target": "zimmetliPersonelId", "source": "field", "path": "fields.personelId" },
        { "target": "zimmetRef", "source": "field", "path": "key" }
      ],
      "clearFields": ["depoId", "lokasyonId"]
    }
  ]
}
