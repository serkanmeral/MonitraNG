{
  "name": "zimmet_markalar",
  "description": "Zimmet — urun marka tanimlari",
  "forceSchema": true,
  "logging": "self",
  "publish_mode": "none",
  "indexList": [
    { "name": "idx_kod", "fields": { "kod": 1 }, "unique": true }
  ],
  "fields": [
    {
      "fieldType": "text",
      "name": "kod",
      "title": "Marka kodu",
      "mandatory": true,
      "unique": true,
      "isArray": false,
      "validation": {
        "minLength": 3,
        "maxLength": 20,
        "pattern": "^MRK-[A-Z0-9]+$",
        "message": "Kod MRK-XXX formatinda olmalidir"
      }
    },
    {
      "fieldType": "text",
      "name": "ad",
      "title": "Marka adi",
      "mandatory": true,
      "unique": true,
      "isArray": false,
      "validation": { "minLength": 2, "maxLength": 80 }
    },
    {
      "fieldType": "text",
      "name": "aciklama",
      "title": "Aciklama",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": { "maxLength": 8000 }
    },
    {
      "fieldType": "bool",
      "name": "aktif",
      "title": "Aktif",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "defaultValue": true
    }
  ]
}
