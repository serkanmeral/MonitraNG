  "dataset": "@widget_templates",
  "records": [
    {
      "templateId": "alarm.open-count-stat",
      "templateVersion": "1.0.0",
      "domain": "alarm",
      "categoryName": "alarm-kpi",
      "title": "Açık alarm sayısı",
      "description": "Onaylanmamış açık alarmların anlık sayısı",
      "tags": ["kpi", "realtime"],
      "order": 10,
      "isSystem": true,
      "isActive": true,
      "manifest": {
        "manifestVersion": "1.0",
        "templateId": "alarm.open-count-stat",
        "templateVersion": "1.0.0",
        "domain": "alarm",
        "category": "alarm-kpi",
        "title": { "tr": "Açık alarm sayısı", "en": "Open alarm count" },
        "description": { "tr": "Onaylanmamış açık alarmların anlık sayısı", "en": "Current count of open unacknowledged alarms" },
        "tags": ["kpi", "realtime"],
        "presentation": {
          "kind": "stat",
          "defaultPreset": "stat-simple",
          "allowedPresets": ["stat-simple", "stat-sparkline"],
          "config": { "format": "number", "icon": "mdi-bell-alert", "color": "error" }
        },
        "dataBinding": {
          "serviceRef": "mngalarm:alarms/dashboard-snapshot",
          "defaultParameters": {
            "rangeHours": { "$ref": "$timeRange.hours" },
            "minSeverity": { "$ref": "$variables.severity" }
          },
          "fieldMap": { "value": "openTotal" }
        },
        "parametersSchema": [
          {
            "name": "minSeverity",
            "type": "enum",
            "label": { "tr": "Minimum önem", "en": "Minimum severity" },
            "enum": [
              { "value": 0, "label": { "tr": "Tümü", "en": "All" } },
              { "value": 3, "label": { "tr": "Yüksek+", "en": "High+" } },
              { "value": 4, "label": { "tr": "Kritik", "en": "Critical" } }
            ],
            "default": 0,
            "bindToContext": "variables.severity"
          }
        ],
        "interactions": {
          "drillDown": {
            "type": "route",
            "path": "/apps/alarm-center/alarms",
            "paramMap": { "openOnly": "true", "minSeverity": "$variables.severity" }
          }
        },
        "export": { "supportsPdf": true, "supportsCsv": false, "supportsPng": true, "supportsSnapshot": true }
      }
    },
