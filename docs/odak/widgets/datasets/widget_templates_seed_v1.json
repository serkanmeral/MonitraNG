              "label": { "tr": "Detay", "en": "Detail" },
              "icon": "mdi-open-in-new",
              "parameterMap": { "alarmId": "$row.id" }
            },
            {
              "id": "alarm.acknowledge",
              "type": "api",
              "label": { "tr": "Onayla", "en": "Acknowledge" },
              "icon": "mdi-check",
              "parameterMap": { "alarmId": "$row.id" },
              "requiredGroups": ["admins"]
            }
          ]
        },
        "export": { "supportsPdf": true, "supportsCsv": true, "supportsPng": false, "supportsSnapshot": true }
      }
