# Production sunucu — mng_apps .env özeti (TEST .env KOPYALANMAZ)
# Konum: /home/odak/MonitraNG/ApplicationResources/mng_apps/.env
# Kaynak: cp .env.odak.prod.example .env
# Tam şablon: ApplicationResources/mng_apps/.env.odak.prod.example
# Ic servisler: mongo, keycloak (ayni production host — 20.20 degil)

ENVIRONMENT=Production
DOMAIN=192.168.20.8
OPENAPI_SERVER_PATH=http://192.168.20.8:5040

CORS_ALLOWED_ORIGIN_1=http://192.168.20.8:3000
MNG_KEEPER_UI_BASE_URL=http://192.168.20.8:3000

GATEWAY_URL=http://192.168.20.8:5040
KEEPER_URL=http://192.168.20.8:5001
DATAGATEWAY_URL=http://192.168.20.8:5010
HUB_URL=http://192.168.20.8:5020
MNGKEEPER_ENGINE_URL=http://192.168.20.8:5001

# mng_common (.env) — aynı sunucuda:
# ODAK_KEYCLOAK_HOSTNAME=192.168.20.8

# Zorunlu (production Keycloak'ta YENİ üretin — test secret KOPYALAMAYIN):
# KEYCLOAK_CLIENT_SECRET=...
# MNGKEEPER_LICENSE_MASTER_KEY=...  (>= 32 karakter)

# İç servis URL'leri (mongo, keycloak, redis host adları) test ile AYNI kalır — değiştirmeyin:
# KEYCLOAK_BASE_URL=http://keycloak:8080
# MONGO_CONNECTION_STRING=mongodb://admin:...@mongo:27017/...
