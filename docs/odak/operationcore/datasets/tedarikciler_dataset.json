{
  "name": "tedarikciler",
  "description": "Tedarikci master verisi — OC lookup + Automated Forms POC",
  "forceSchema": true,
  "logging": "self",
  "publish_mode": "none",
  "fields": [
    {
      "fieldType": "text",
      "name": "kod",
      "title": "Tedarikci kodu",
      "mandatory": true,
      "unique": true,
      "isArray": false,
      "validation": {
        "minLength": 3,
        "maxLength": 20,
        "pattern": "^TED-[0-9]{3}$",
        "message": "Kod TED-XXX formatinda olmalidir"
      }
    },
    {
      "fieldType": "text",
      "name": "unvan",
      "title": "Unvan",
      "mandatory": true,
      "unique": false,
      "isArray": false,
      "validation": {
        "minLength": 2,
        "maxLength": 200
      }
    },
    {
      "fieldType": "select",
      "name": "tedarikciTipi",
      "title": "Tedarikci tipi",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "options": {
        "lookup": {
          "source": "static",
          "staticItems": [
            { "value": "Malzeme", "label": "Malzeme" },
            { "value": "Hizmet", "label": "Hizmet" },
            { "value": "Karma", "label": "Karma" }
          ]
        }
      }
    },
    {
      "fieldType": "relation",
      "name": "anaTedarikciId",
      "title": "Ana tedarikci",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "relationDataset": "tedarikciler"
    },
    {
      "fieldType": "text",
      "name": "vergiNo",
      "title": "Vergi no",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": {
        "pattern": "^[0-9]{10,11}$",
        "message": "Vergi no 10 veya 11 haneli olmalidir"
      }
    },
    {
      "fieldType": "number",
      "name": "odemeVadesiGun",
      "title": "Odeme vadesi (gun)",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": {
        "min": 0,
        "max": 365
      }
    },
    {
      "fieldType": "text",
      "name": "ilgiliKisi",
      "title": "Ilgili kisi",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": {
        "maxLength": 100
      }
    },
    {
      "fieldType": "text",
      "name": "email",
      "title": "E-posta",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": {
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "message": "Gecerli bir e-posta adresi girin"
      }
    },
    {
      "fieldType": "text",
      "name": "telefon",
      "title": "Telefon",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": {
        "maxLength": 30
      }
    },
    {
      "fieldType": "text",
      "name": "webSitesi",
      "title": "Web sitesi",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": {
        "maxLength": 200
      }
    },
    {
      "fieldType": "text",
      "name": "ulke",
      "title": "Ulke",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": {
        "maxLength": 60
      }
    },
    {
      "fieldType": "text",
      "name": "sehir",
      "title": "Sehir",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": {
        "maxLength": 60
      }
    },
    {
      "fieldType": "text",
      "name": "ilce",
      "title": "Ilce",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": {
        "maxLength": 60
      }
    },
    {
      "fieldType": "text",
      "name": "adres",
      "title": "Adres",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": {
        "maxLength": 500
      }
    },
    {
      "fieldType": "text",
      "name": "notlar",
      "title": "Notlar",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": {
        "maxLength": 1000
      }
    },
    {
      "fieldType": "bool",
      "name": "isActive",
      "title": "Aktif",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "defaultValue": true
    }
  ],
  "indexList": [
    {
      "name": "idx_kod",
      "fields": { "kod": 1 },
      "unique": true
    },
    {
      "name": "idx_unvan",
      "fields": { "unvan": 1 },
      "unique": false
    },
    {
      "name": "idx_isActive",
      "fields": { "isActive": 1 },
      "unique": false
    },
    {
      "name": "idx_sehir",
      "fields": { "sehir": 1 },
      "unique": false
    }
  ]
}
