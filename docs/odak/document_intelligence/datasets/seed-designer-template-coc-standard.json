{
  "categoryPath": ["Kalite Belgeleri", "CoC / Uygunluk Sertifikaları"],
  "template": {
    "name": "Uygunluk Belgesi",
    "code": "COC-STANDARD",
    "description": "ODK-COC referans şablonu — placeholder gövde, 3 sütunlu antet, kurumsal altbilgi.",
    "primaryContextType": "odak.siparis.line",
    "generationProfile": "odak.coc.fromLine",
    "docxFile": "ODK-COC-template-seed.docx",
    "letterhead": {
      "enabled": true,
      "showLogo": true,
      "showDocumentName": true,
      "showDocumentNumber": true,
      "showGeneratedAt": true
    },
    "footer": {
      "enabled": true,
      "showFormRevision": true,
      "showOfficeColumns": true,
      "showAddresses": true,
      "showContacts": true,
      "showDividerLine": false
    },
    "pageLayout": {
      "marginTopTwips": 1440,
      "marginRightTwips": 1797,
      "marginBottomTwips": 1440,
      "marginLeftTwips": 1797,
      "headerDistanceTwips": 709,
      "footerDistanceTwips": 658,
      "footerLeftIndentTwips": -567
    },
    "parameters": [
      {
        "key": "documentName",
        "label": "Belge Adı",
        "dataType": "text",
        "valueSourceMode": "static",
        "defaultValue": "Uygunluk Belgesi"
      },
      {
        "key": "docNo",
        "label": "Belge Numarası",
        "dataType": "text",
        "valueSourceMode": "incremental",
        "incremental": {
          "format": "ODK-COC-{yy}-{0}",
          "startValue": 1,
          "incrementStep": 1,
          "scopeKey": "odak-coc-docno",
          "resetPolicy": "yearly"
        }
      },
      {
        "key": "workPackageNo",
        "label": "İş Paketi No",
        "dataType": "text",
        "valueSourceMode": "context",
        "contextBinding": { "path": "parentPackageId.packageNo" }
      },
      {
        "key": "issueDate",
        "label": "Düzenlenme Tarihi",
        "dataType": "date",
        "valueSourceMode": "generated",
        "format": "dd.MM.yyyy"
      },
      {
        "key": "customerName",
        "label": "Firma Bilgileri",
        "dataType": "text",
        "valueSourceMode": "context",
        "contextBinding": { "path": "parentPackageId.customerId.unvan" }
      },
      {
        "key": "orderNo",
        "label": "Sipariş No",
        "dataType": "text",
        "valueSourceMode": "context",
        "contextBinding": { "path": "customerPoNo" }
      },
      {
        "key": "partDescription",
        "label": "Parça Tanımı",
        "dataType": "text",
        "valueSourceMode": "context",
        "contextBinding": { "path": "description" }
      },
      {
        "key": "drawingNo",
        "label": "Teknik Resim No",
        "dataType": "text",
        "valueSourceMode": "context",
        "contextBinding": { "path": "productId.partNumber" }
      },
      {
        "key": "drawingRef",
        "label": "Teknik Resim Referansı (GN)",
        "dataType": "text",
        "valueSourceMode": "manual"
      },
      {
        "key": "drawingRevision",
        "label": "TR Revizyon No",
        "dataType": "text",
        "valueSourceMode": "context",
        "contextBinding": {
          "path": "poItemRevNo",
          "fallbackPath": "productId.revizyon"
        }
      },
      {
        "key": "partQuantity",
        "label": "Parça Adedi",
        "dataType": "text",
        "valueSourceMode": "context",
        "contextBinding": {
          "path": "quantity",
          "format": "{quantity} {unit}"
        }
      },
      {
        "key": "serialNo",
        "label": "Parça Seri No",
        "dataType": "text",
        "valueSourceMode": "manual"
      },
      {
        "key": "leakTestNoteNo",
        "label": "Sızdırmazlık test not no",
        "dataType": "text",
        "valueSourceMode": "manual"
      },
      {
        "key": "leakTestPressureMbar",
        "label": "Test basıncı (mbar)",
        "dataType": "text",
        "valueSourceMode": "manual"
      },
      {
        "key": "signatoryName",
        "label": "İmza — ad soyad",
        "dataType": "text",
        "valueSourceMode": "static",
        "defaultValue": "GİZEM CANDAŞ"
      },
      {
        "key": "signatoryTitle",
        "label": "İmza — unvan",
        "dataType": "text",
        "valueSourceMode": "static",
        "defaultValue": "KALİTE KONTROL YÖNETİCİSİ"
      },
      {
        "key": "generatedAt",
        "label": "Üretim zamanı",
        "dataType": "date",
        "valueSourceMode": "generated",
        "format": "dd.MM.yyyy"
      }
    ]
  }
}
