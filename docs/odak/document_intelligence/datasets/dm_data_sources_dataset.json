{
  "name": "dm_data_sources",
  "description": "Document Intelligence — reusable parameter data source catalog (G4)",
  "forceSchema": true,
  "logging": "self",
  "publish_mode": "none",
  "fields": [
    {
      "fieldType": "text",
      "name": "code",
      "title": "Data source code",
      "mandatory": true,
      "unique": true,
      "isArray": false,
      "validation": { "maxLength": 128 }
    },
    {
      "fieldType": "text",
      "name": "displayName",
      "title": "Display name",
      "mandatory": true,
      "unique": false,
      "isArray": false,
      "validation": { "maxLength": 256 }
    },
    {
      "fieldType": "text",
      "name": "provider",
      "title": "Provider (dg, mo, …)",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": { "maxLength": 32 }
    },
    {
      "fieldType": "text",
      "name": "definitionJson",
      "title": "valueSource JSON",
      "mandatory": true,
      "unique": false,
      "isArray": false,
      "validation": { "maxLength": 32000 }
    },
    {
      "fieldType": "bool",
      "name": "isActive",
      "title": "Active",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "defaultValue": true
    }
  ],
  "indexList": [
    {
      "name": "idx_code",
      "fields": { "code": 1 },
      "unique": true
    }
  ]
}
