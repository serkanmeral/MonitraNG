        "label": "Kalem Sayısı",
        "dataType": "number",
        "valueSourceMode": "context",
        "contextBinding": { "path": "lineCount" }
      },
      {
        "key": "partCount",
        "label": "Parça Sayısı",
        "dataType": "number",
        "valueSourceMode": "context",
        "contextBinding": { "path": "partCount" }
      },
      {
        "key": "stockCount",
        "label": "Stok",
        "dataType": "number",
        "valueSourceMode": "context",
        "contextBinding": { "path": "stockCount" }
      },
      {
        "key": "shippedCount",
        "label": "Sevk",
        "dataType": "number",
        "valueSourceMode": "context",
        "contextBinding": { "path": "shippedCount" }
