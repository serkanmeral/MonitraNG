      {
        "key": "openNcrCount",
        "label": "Açık NCR",
        "dataType": "number",
        "valueSourceMode": "manual",
        "defaultValue": "0"
      },
      {
        "key": "openCapaCount",
        "label": "Açık CAPA",
        "dataType": "number",
        "valueSourceMode": "manual",
        "defaultValue": "0"
      },
      {
