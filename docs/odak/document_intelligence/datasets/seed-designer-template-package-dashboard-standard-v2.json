      {
        "key": "deliveryAddress",
        "label": "Sevkiyat Adresi",
        "dataType": "text",
        "valueSourceMode": "context",
        "contextBinding": { "path": "deliveryAddress" }
      },
      {
        "key": "issueDate",
        "label": "Liste Tarihi",
        "dataType": "date",
        "valueSourceMode": "generated",
