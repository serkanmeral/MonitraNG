        "kind": "table",
        "dataType": "table",
        "valueSourceMode": "manual",
        "dataSourceRef": "odak.packageLines.byPackage",
        "docBinding": {
          "regionKind": "sheet",
          "tableIndex": 2,
          "headerRowIndex": 2,
          "templateRowIndex": 3
        }
      },
      {
        "key": "donutSlices",
        "label": "Tamamlanma dilimleri",
        "kind": "table",
        "dataType": "table",
        "valueSourceMode": "manual",
        "docBinding": {
          "regionKind": "sheet",
          "tableIndex": 2,
          "headerRowIndex": 0,
          "templateRowIndex": 1
        }
      }
    ]
  }
}
