    "primaryContextType": "odak.siparis.package",
    "generationProfile": "odak.package.dashboard.fromPackage",
    "xlsxFile": "v2/ODK-PACKAGE-DASHBOARD-template-seed-v2.xlsx",
    "letterhead": {
      "enabled": true,
      "showLogo": false,
      "showDocumentName": false,
      "showDocumentNumber": false,
      "showGeneratedAt": false
    },
    "parameters": [
      {
        "key": "domainLogo",
        "label": "Logo",
        "kind": "image",
        "dataType": "image",
        "valueSourceMode": "domain",
        "docBinding": {
          "regionKind": "xlsxLogo"
        }
      },
      {
        "key": "packageNo",
        "label": "İş Paketi No",
        "dataType": "text",
        "valueSourceMode": "context",
        "contextBinding": { "path": "packageNo" }
      },
      {
        "key": "packageName",
        "label": "İş Paketi Adı",
        "dataType": "text",
        "valueSourceMode": "context",
        "contextBinding": { "path": "name" }
      },
      {
        "key": "customerName",
        "label": "Müşteri",
        "dataType": "text",
        "valueSourceMode": "context",
        "contextBinding": { "path": "customerId.unvan" }
      },
      {
        "key": "statusLabel",
        "label": "Durum",
        "dataType": "text",
        "valueSourceMode": "context",
        "contextBinding": { "path": "status", "defaultValue": "—" }
