        "valueSourceMode": "manual",
        "defaultValue": "—"
      },
      {
        "key": "fulfillmentPctLabel",
        "label": "Tamamlanma etiketi",
        "dataType": "text",
        "valueSourceMode": "manual",
        "defaultValue": "—"
      },
      {
        "key": "shipmentSummary",
        "label": "Sevkiyat özeti",
        "dataType": "text",
        "valueSourceMode": "manual",
        "defaultValue": "0/0"
