{
  "_comment": "POST /api/v1/data/@mail_layouts — kurulum oncesi dataset semasi notifier_datasets.json ile olusturulur",
  "dataset": "@mail_layouts",
  "records": [
    {
      "layoutKey": "default",
      "name": "Varsayilan MonitraNG layout",
      "description": "Logo + domain adi header; standart footer. Tum system sablonlari icin varsayilan.",
      "stylesCss": "body{margin:0;padding:0;background-color:#f5f5f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;}.email-wrapper{width:100%;background-color:#f5f5f5;padding:20px 0;}.email-container{max-width:600px;margin:0 auto;background-color:#ffffff;}.email-header{background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);padding:32px 24px;text-align:center;}.header-logo{display:block;margin:0 auto 16px;max-height:84px;max-width:280px;width:auto;height:auto;}.header-title{color:#ffffff;font-size:22px;font-weight:600;margin:0;}.email-body{padding:32px 24px;color:#333333;font-size:16px;line-height:1.6;}.email-footer{background-color:#f8f9fa;padding:24px;text-align:center;font-size:13px;color:#6c757d;border-top:1px solid #e9ecef;}.info-box{background-color:#f8f9fa;border-left:4px solid #667eea;padding:16px 20px;margin:20px 0;border-radius:4px;}.info-box-title{font-size:17px;font-weight:600;margin:0 0 12px 0;}.credentials-box{background-color:#fff3cd;border:2px solid #ffc107;border-radius:6px;padding:16px 20px;margin:20px 0;}",
      "headerHtml": "<div class=\"email-header\"><img src=\"{{domain.logoUrl}}\" alt=\"{{domain.displayName}}\" class=\"header-logo\" /><h1 class=\"header-title\">{{domain.displayName}}</h1></div>",
      "footerHtml": "<div class=\"email-footer\"><p style=\"margin:4px 0;\">Bu e-posta {{domain.displayName}} tarafindan MonitraNG uzerinden gonderilmistir.</p><p style=\"margin:4px 0;color:#adb5bd;\">Lutfen bu mesaja yanit vermeyiniz (otomatik bildirim).</p></div>",
      "isDefault": true,
      "isActive": true,
      "category": "system"
    },
    {
      "layoutKey": "minimal",
      "name": "Minimal layout",
      "description": "Logo yok; yalnizca domain adi metin header.",
      "stylesCss": "body{margin:0;padding:0;background-color:#ffffff;font-family:Arial,sans-serif;}.email-wrapper{padding:16px;}.email-container{max-width:600px;margin:0 auto;}.email-header{padding:16px 0;border-bottom:2px solid #667eea;}.header-title{font-size:20px;font-weight:600;color:#333;margin:0;}.email-body{padding:24px 0;color:#333;line-height:1.5;}.email-footer{padding:16px 0;font-size:12px;color:#888;border-top:1px solid #eee;}",
      "headerHtml": "<div class=\"email-header\"><h1 class=\"header-title\">{{domain.displayName}}</h1></div>",
      "footerHtml": "<div class=\"email-footer\"><p>{{domain.displayName}}</p></div>",
      "isDefault": false,
      "isActive": true,
      "category": "system"
    }
  ]
}
