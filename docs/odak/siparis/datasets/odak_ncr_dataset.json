{
  "name": "odak_ncr",
  "description": "Odak Siparis — uygunsuzluk (NCR), kurum Kalite ncs tablosu ile uyumlu alanlar",
  "forceSchema": true,
  "logging": "self",
  "publish_mode": "none",
  "fields": [
    {
      "fieldType": "incremental",
      "name": "ncrNo",
      "title": "NCR No (DG)",
      "mandatory": true,
      "unique": true,
      "isArray": false,
      "incrementalOptions": {
        "format": "NCR-{0:D4}",
        "startValue": 1,
        "incrementStep": 1
      }
    },
    {
      "fieldType": "text",
      "name": "legacyNcNo",
      "title": "Kurum nc_no",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "validation": { "maxLength": 20 }
    },
    {
      "fieldType": "select",
      "name": "recordScope",
      "title": "Kayit kapsami",
      "mandatory": true,
      "unique": false,
      "isArray": false,
      "defaultValue": "Paketli",
      "options": {
        "lookup": {
          "source": "static",
          "staticItems": [
            { "value": "Paketli", "label": "Is paketine bagli" },
            { "value": "Genel", "label": "Genel uygunsuzluk" }
          ]
        }
      }
    },
    {
      "fieldType": "relation",
      "name": "parentPackageId",
      "title": "Is paketi",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "relationDataset": "odak_is_paketleri"
    },
    {
      "fieldType": "relation",
      "name": "parentLineId",
      "title": "Siparis kalemi",
      "mandatory": false,
      "unique": false,
      "isArray": false,
      "relationDataset": "odak_siparis_kalemleri"
    },
    {
      "fieldType": "select",
      "name": "ncStatus",
      "title": "Durum (nc_status)",
      "mandatory": true,
      "unique": false,
      "isArray": false,
      "defaultValue": "Değerlendirme Bekleniyor",
      "options": {
        "lookup": {
          "source": "static",
          "staticItems": [
            { "value": "MRB Bekleniyor", "label": "MRB Bekleniyor" },
            { "value": "Rework/Kontrol Bekleniyor", "label": "Rework/Kontrol Bekleniyor" },
            { "value": "Değerlendirme Bekleniyor", "label": "Değerlendirme Bekleniyor" },
            { "value": "DF No Bekleniyor", "label": "DF No Bekleniyor" },
            { "value": "Müşteri Dönüşü Bekleniyor", "label": "Müşteri Dönüşü Bekleniyor" },
            { "value": "DF Düzenlenecek", "label": "DF Düzenlenecek" },
            { "value": "Kapalı", "label": "Kapalı" }
          ]
        }
      }
    },
