        "lookup": {
          "source": "static",
          "staticItems": [
            { "value": "FAI Bekliyor", "label": "FAI Bekliyor" },
            { "value": "FAI Yapıldı", "label": "FAI Yapıldı" },
            { "value": "FAI Formu Doldurulmayacak", "label": "FAI Formu Doldurulmayacak" }
          ]
        }
      }
