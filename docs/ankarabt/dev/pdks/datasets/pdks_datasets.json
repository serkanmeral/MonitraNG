[
  {
    "name": "pdks_ayarlar",
    "description": "Kapı geçiş ayarı. Beklenen giriş ve çıkış saati. İlk kayıt tekildir. İkinci satır, kapı ayrı saat kullanınca açılır.",
    "forceSchema": true,
    "logging": "none",
    "publish_mode": "none",
    "indexList": [
      { "name": "idx_tekil", "fields": { "tekil": 1 }, "unique": true }
    ],
    "fields": [
      {
        "fieldType": "text",
        "name": "tekil",
        "title": "Tekil anahtar",
        "mandatory": true,
        "unique": true,
        "isArray": false,
        "defaultValue": "ayar",
        "validation": { "maxLength": 40 }
      },
      {
        "fieldType": "text",
        "name": "girisSaati",
        "title": "Giriş saati",
        "mandatory": true,
        "unique": false,
        "isArray": false,
        "validation": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "maxLength": 5,
          "message": "Saat SS:dd biçimindedir. Örnek: 08:30."
        }
      },
      {
        "fieldType": "text",
        "name": "cikisSaati",
        "title": "Çıkış saati",
        "mandatory": true,
        "unique": false,
        "isArray": false,
        "validation": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "maxLength": 5,
          "message": "Saat SS:dd biçimindedir. Örnek: 17:30."
        }
      },
      {
        "fieldType": "number",
        "name": "toleransDakika",
        "title": "Tolerans dakika",
        "mandatory": true,
        "unique": false,
        "isArray": false,
        "defaultValue": 0,
        "validation": { "min": 0, "message": "Tolerans sıfır veya daha büyük bir dakikadır." }
      },
      {
        "fieldType": "number",
        "name": "panoYenilemeSaniye",
        "title": "Pano yenileme (saniye)",
        "mandatory": false,
        "unique": false,
        "isArray": false,
        "defaultValue": 60,
        "validation": { "min": 15, "max": 600, "message": "Pano 15 ile 600 saniye arasında yenilenir." }
      },
      {
        "fieldType": "text",
        "name": "karsilamaGiris",
        "title": "Giriş cümlesi",
        "mandatory": false,
        "unique": false,
        "isArray": false,
        "defaultValue": "İyi çalışmalar.",
        "validation": { "maxLength": 160 }
      },
      {
        "fieldType": "text",
        "name": "karsilamaZamaninda",
        "title": "Zamanında giriş cümlesi",
        "mandatory": false,
        "unique": false,
        "isArray": false,
        "defaultValue": "Zamanında geldiğiniz için teşekkürler.",
        "validation": { "maxLength": 160 }
      },
      {
        "fieldType": "text",
        "name": "karsilamaGec",
        "title": "Geç giriş cümlesi",
        "mandatory": false,
        "unique": false,
        "isArray": false,
        "defaultValue": "Yolunuz düştü, yine de hoş geldiniz.",
        "validation": { "maxLength": 160 }
      },
      {
        "fieldType": "text",
        "name": "karsilamaCikis",
        "title": "Çıkış cümlesi",
        "mandatory": false,
        "unique": false,
        "isArray": false,
        "defaultValue": "Güle güle.",
        "validation": { "maxLength": 160 }
      }
    ],
    "validations": [],
    "queries": []
  },
  {
