      { "name": "idx_kapi_zaman", "fields": { "doorKey": 1, "occurredAt": -1 }, "unique": false },
      { "name": "idx_lokasyon_zaman", "fields": { "locationKey": 1, "occurredAt": -1 }, "unique": false }
    ],
    "fields": [
