        "unique": true,
        "isArray": false,
        "validation": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 40 }
      },
      {
        "fieldType": "text",
        "name": "title",
        "title": "Ad",
        "mandatory": true,
        "unique": false,
        "isArray": false,
        "validation": { "maxLength": 80 }
      },
      {
        "fieldType": "text",
        "name": "dashboardSlug",
        "title": "Pano",
        "mandatory": false,
        "unique": false,
        "isArray": false,
        "validation": { "maxLength": 80 }
      },
      {
        "fieldType": "bool",
        "name": "active",
        "title": "Aktif",
        "mandatory": true,
        "unique": false,
        "isArray": false,
        "defaultValue": true
      },
      {
        "fieldType": "relation",
        "name": "ayar",
        "title": "Varsayılan geçiş ayarı",
        "mandatory": false,
        "unique": false,
        "isArray": false,
        "relationDataset": "pdks_ayarlar"
      }
    ],
    "validations": [],
    "queries": []
  },
