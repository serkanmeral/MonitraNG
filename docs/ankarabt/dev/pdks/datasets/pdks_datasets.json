        "mandatory": true,
        "unique": false,
        "isArray": false
      },
      {
        "fieldType": "select",
        "name": "result",
        "title": "Sonuç",
        "mandatory": true,
        "unique": false,
        "isArray": false,
        "options": {
          "lookup": {
            "source": "static",
            "staticItems": [
              { "value": "accepted", "label": "Kabul" },
              { "value": "ignored", "label": "Çift okuma" },
              { "value": "rejected", "label": "Red" }
