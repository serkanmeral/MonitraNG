        "unique": false,
        "isArray": false
      },
      {
        "fieldType": "text",
        "name": "displayName",
        "title": "Ad",
        "mandatory": true,
        "unique": false,
        "isArray": false,
        "validation": { "maxLength": 80 }
      },
      {
        "fieldType": "text",
        "name": "fullName",
        "title": "Ad soyad",
        "mandatory": false,
        "unique": false,
        "isArray": false,
        "validation": { "maxLength": 120 }
      },
      {
        "fieldType": "text",
        "name": "greeting",
        "title": "Karşılama",
        "mandatory": false,
        "unique": false,
        "isArray": false,
        "validation": { "maxLength": 160 }
      },
      {
        "fieldType": "text",
        "name": "sinif",
        "title": "Sınıf",
        "mandatory": false,
        "unique": false,
        "isArray": false,
        "validation": { "maxLength": 20 }
      },
      {
        "fieldType": "text",
        "name": "doorKey",
        "title": "Kapı",
        "mandatory": true,
        "unique": false,
        "isArray": false,
        "validation": { "maxLength": 40 }
      },
      {
        "fieldType": "text",
        "name": "locationKey",
        "title": "Lokasyon",
        "mandatory": false,
        "unique": false,
        "isArray": false,
        "validation": { "maxLength": 40 }
      },
      {
        "fieldType": "select",
        "name": "direction",
        "title": "Yön",
        "mandatory": true,
        "unique": false,
        "isArray": false,
        "options": {
          "lookup": {
            "source": "static",
            "staticItems": [
              { "value": "in", "label": "Giriş" },
              { "value": "out", "label": "Çıkış" },
              { "value": "break", "label": "Mola" },
              { "value": "return", "label": "Dönüş" }
