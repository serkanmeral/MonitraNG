{
  "MngLLMSettings": {
    "Server": {
      "Host": "0.0.0.0",
      "Port": 5030,
      "Scheme": "https"
    },
    "OpenApiServerPath": "https://localhost:5030",
    "Ollama": {
      "BaseUrl": "http://ollama:11434",
      "DefaultModel": "qwen2.5:3b",
      "Timeout": 30
