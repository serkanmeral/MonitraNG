      "MngDataGateway": "https://localhost:5010"
    },
    "Cors": {
      "AllowedOrigins": ["http://localhost:3000", "https://localhost:3000"],
      "AllowCredentials": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
