{
  "MngLLMSettings": {
    "Server": {
      "Host": "0.0.0.0",
      "Port": 5030,
      "Scheme": "http"
    },
    "OpenApiServerPath": "https://api.monitra.local/llm",
    "Ollama": {
      "BaseUrl": "http://ollama:11434",
      "DefaultModel": "qwen2.5:3b",
      "Timeout": 120,
      "MaxRetries": 2,
      "EnableStreaming": false
    },
    "Translation": {
      "SupportedLanguages": ["tr", "en", "fr", "ar", "zh"],
      "CacheEnabled": true,
      "CacheTTL": 3600
    },
    "CertificateSettings": {
      "DNS": "",
      "CERT_FILE": "",
      "KEY_FILE": ""
    },
    "Actors": {
      "MngKeeper": "http://mngkeeper:5001",
      "MngDataGateway": "http://mngdatagateway:5010"
    },
    "Documentation": {
      "MarkdownPath": "../../docs/content",
      "SearchLimit": 5,
      "ReindexIntervalMinutes": 60,
      "EnableAutoReindex": true,
      "ServiceEndpoints": [
        {
          "ServiceName": "MngDataGateway",
          "BaseUrl": "http://mngdatagateway:5010",
          "OpenApiPath": "/api-docs/v1/swagger.json"
        },
        {
          "ServiceName": "MngKeeper",
          "BaseUrl": "http://mngkeeper:5001",
          "OpenApiPath": "/api-docs/v1/swagger.json"
        },
        {
          "ServiceName": "MngHub",
          "BaseUrl": "http://mnghub:5020",
          "OpenApiPath": "/api-docs/v1/swagger.json"
        },
        {
          "ServiceName": "MngLLM",
          "BaseUrl": "http://mngllm:5030",
          "OpenApiPath": "/api-docs/v1/swagger.json"
        },
        {
          "ServiceName": "MngGateway",
          "BaseUrl": "http://mnggateway:5040",
          "OpenApiPath": "/api-docs/v1/swagger.json"
        },
        {
          "ServiceName": "MngNotifier",
          "BaseUrl": "http://mngnotifier:5070",
          "OpenApiPath": "/api-docs/v1/swagger.json"
        },
        {
          "ServiceName": "MngScheduler",
          "BaseUrl": "http://mngscheduler:5090",
          "OpenApiPath": "/api-docs/v1/swagger.json"
        },
        {
          "ServiceName": "MngAdmin",
          "BaseUrl": "http://mngadmin:5080",
          "OpenApiPath": "/api-docs/v1/swagger.json"
        }
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
