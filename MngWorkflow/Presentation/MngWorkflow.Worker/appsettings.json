{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "MngWorkflowSettings": {
    "MongoDb": {
      "ConnectionString": "mongodb://admin:admin123@mongo:27017",
      "DatabasePrefix": "mng_"
    },
    "RabbitMq": {
      "Host": "rabbitmq",
      "Port": 5672,
      "VirtualHost": "/",
      "Username": "admin",
      "Password": "admin123"
    },
    "Engine": {
      "PrefetchCount": 16,
      "HttpTimeoutSeconds": 30,
      "NodeTimeoutSeconds": 120,
      "MaxAttempts": 3,
      "EventTrigger": {
        "PrefetchCount": 16
      }
    }
  }
}
