{
  "code": "software",
  "version": "1.4.0",
  "name": "Yazılım geliştirme",
  "description": "Geliştirme, inceleme ve test akışı. Üst iş ve iş tipleri.",
  "suggestedWorkspaceType": "team",
  "suggestedPrefix": "YZG",
  "states": [
    { "key": "state.new", "name": "Yeni", "category": "open", "isInitial": true, "color": "secondary" },
    { "key": "state.dev", "name": "Geliştirmede", "category": "in_progress", "color": "primary" },
    { "key": "state.review", "name": "İncelemede", "category": "in_progress", "color": "info" },
    { "key": "state.test", "name": "Testte", "category": "in_progress", "color": "warning" },
    { "key": "state.done", "name": "Tamamlandı", "category": "closed", "color": "success" },
    { "key": "state.rejected", "name": "Reddedildi", "category": "closed", "color": "error" }
  ],
  "flows": [
    {
      "key": "flow.default",
      "name": "Yazılım akışı",
      "isDefault": true,
      "initialStateKey": "state.new",
      "transitions": [
        { "key": "transition.start", "fromStateKey": "state.new", "toStateKey": "state.dev", "label": "Başlat", "requiredFields": ["assignee"] },
        { "key": "transition.review", "fromStateKey": "state.dev", "toStateKey": "state.review", "label": "İncelemeye gönder", "requiredFields": ["assignee"] },
        { "key": "transition.test", "fromStateKey": "state.review", "toStateKey": "state.test", "label": "Teste gönder", "requiredFields": ["assignee"] },
        { "key": "transition.back", "fromStateKey": "state.review", "toStateKey": "state.dev", "label": "Geri gönder", "requiredFields": ["assignee"], "requireComment": true },
        { "key": "transition.testFail", "fromStateKey": "state.test", "toStateKey": "state.dev", "label": "Testi geçemedi", "requiredFields": ["assignee"], "requireComment": true },
        { "key": "transition.complete", "fromStateKey": "state.test", "toStateKey": "state.done", "label": "Tamamla" },
        { "key": "transition.rejectNew", "fromStateKey": "state.new", "toStateKey": "state.rejected", "label": "Reddet", "requireComment": true },
        { "key": "transition.rejectReview", "fromStateKey": "state.review", "toStateKey": "state.rejected", "label": "Reddet", "requireComment": true },
        { "key": "transition.rejectTest", "fromStateKey": "state.test", "toStateKey": "state.rejected", "label": "Reddet", "requireComment": true },
        { "key": "transition.reopen", "fromStateKey": "state.done", "toStateKey": "state.new", "label": "Yeniden aç", "requiredFields": ["assignee"] },
        { "key": "transition.reopenRejected", "fromStateKey": "state.rejected", "toStateKey": "state.new", "label": "Yeniden aç", "requiredFields": ["assignee"] }
      ]
    }
  ],
  "types": [
    { "key": "type.epic", "name": "Üst iş", "flowKey": "flow.default", "requiresParent": false, "childTypeKeys": ["type.work"] },
    { "key": "type.work", "name": "İş", "flowKey": "flow.default", "requiresParent": false, "childTypeKeys": [] }
  ],
  "forms": [
    {
      "key": "form.default",
      "name": "Oluşturma formu",
      "isDefault": true,
      "flowKey": "flow.default",
      "typeKey": "type.work",
      "fields": ["title", "description", "typeId", "reporter", "assignee", "watchers", "priorityId", "startDate", "dueDate", "storyPoints"],
      "defaultPriorityKey": "priority.normal"
    }
  ],
  "boards": [
    {
      "key": "board.default",
      "name": "Pano",
      "isDefault": true,
      "flowKey": "flow.default",
      "formKey": "form.default",
      "typeKey": "type.work",
      "columnStateKeys": ["state.new", "state.dev", "state.review", "state.test", "state.done", "state.rejected"],
      "visibleFields": ["key", "title", "stateId", "assignee", "priorityId", "storyPoints"],
      "listColumns": [
        { "key": "key", "label": "No" },
        { "key": "title", "label": "Başlık" },
        { "key": "stateId", "label": "Durum" },
        { "key": "sprintId", "label": "Sprint", "filterable": false },
        { "key": "assignee", "label": "Atanan" },
        { "key": "priorityId", "label": "Öncelik" },
        { "key": "startDate", "label": "Başlangıç", "filterable": false, "sortable": false, "format": "date" },
        { "key": "dueDate", "label": "Vade", "filterable": false, "format": "date" },
        { "key": "storyPoints", "label": "İş puanı" }
      ]
    }
  ],
  "profiles": [
    {
      "key": "profile.default",
      "name": "Profil",
      "isDefault": true,
      "flowKey": "flow.default",
      "typeKey": "type.work",
      "fields": ["title", "description", "typeId", "priorityId", "storyPoints", "reporter", "assignee", "watchers", "startDate", "dueDate"],
      "sections": [
        { "key": "identity", "title": "Kimlik", "fields": ["title", "description"] },
        { "key": "classification", "title": "Sınıflandırma", "fields": ["typeId", "priorityId", "storyPoints"] },
        { "key": "people", "title": "Kişiler", "fields": ["reporter", "assignee", "watchers"] },
        { "key": "plan", "title": "Plan", "fields": ["startDate", "dueDate"] }
      ],
      "actionKeys": [
        "transition.start",
        "transition.review",
        "transition.test",
        "transition.back",
        "transition.testFail",
        "transition.complete",
        "transition.rejectNew",
        "transition.rejectReview",
        "transition.rejectTest",
        "transition.reopen",
        "transition.reopenRejected"
      ]
    }
  ],
  "poolFields": [
    { "key": "dueDate", "label": "Vade", "fieldType": "datetime" },
    { "key": "startDate", "label": "Başlangıç", "fieldType": "date" },
    { "key": "watchers", "label": "İzleyenler", "fieldType": "persons" },
    { "key": "reporter", "label": "Talep eden", "fieldType": "persons" },
    { "key": "storyPoints", "label": "İş puanı", "fieldType": "number" }
  ],
  "priorities": [
    { "key": "priority.urgent", "name": "Acil", "level": "1", "color": "error", "sortOrder": 1 },
    { "key": "priority.high", "name": "Yüksek", "level": "2", "color": "warning", "sortOrder": 2 },
    { "key": "priority.normal", "name": "Normal", "level": "3", "color": "info", "sortOrder": 3 },
    { "key": "priority.low", "name": "Düşük", "level": "4", "color": "secondary", "sortOrder": 4 }
  ],
  "views": { "sprints": true, "calendar": true, "gantt": true },
  "libraryFolders": []
}
