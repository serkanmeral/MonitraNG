        { "key": "transition.resume", "fromStateKey": "state.waiting", "toStateKey": "state.progress", "label": "Sürdür" },
        { "key": "transition.close", "fromStateKey": "state.progress", "toStateKey": "state.closed", "label": "Kapat", "requireComment": true },
        { "key": "transition.closeWaiting", "fromStateKey": "state.waiting", "toStateKey": "state.closed", "label": "Kapat", "requireComment": true },
        { "key": "transition.rejectNew", "fromStateKey": "state.new", "toStateKey": "state.rejected", "label": "Reddet", "requireComment": true },
        { "key": "transition.rejectProgress", "fromStateKey": "state.progress", "toStateKey": "state.rejected", "label": "Reddet", "requireComment": true },
        { "key": "transition.reopen", "fromStateKey": "state.closed", "toStateKey": "state.progress", "label": "Yeniden aç", "requiredFields": ["assignee"] },
        { "key": "transition.reopenRejected", "fromStateKey": "state.rejected", "toStateKey": "state.progress", "label": "Yeniden aç", "requiredFields": ["assignee"] }
      ]
    }
