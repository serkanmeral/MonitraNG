    { "key": "state.waiting", "name": "Beklemede", "category": "in_progress", "color": "warning" },
    { "key": "state.closed", "name": "Kapatıldı", "category": "closed", "color": "success" },
    { "key": "state.rejected", "name": "Reddedildi", "category": "closed", "color": "error" }
  ],
  "flows": [
