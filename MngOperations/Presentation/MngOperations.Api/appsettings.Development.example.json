{
  "_comment": "Kopyala: appsettings.Development.json — Odak / yerel geliştirme",
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "MngOperations": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://192.168.20.20:5341",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Properties": {
      "Application": "MngOperations.Api",
      "Environment": "Development"
    }
  },
  "Jwt": {
    "Authority": "http://192.168.20.20:8080/keycloak/realms/odak",
    "RequireHttpsMetadata": false
  },
  "MngOperationsSettings": {
    "Server": {
      "Host": "0.0.0.0",
      "Port": 5086
    },
    "OpenApiServerPath": "http://192.168.20.20:5040/operations",
    "Actors": {
      "MngKeeper": "http://192.168.20.20:5001",
      "KeycloakBaseUrl": "http://192.168.20.20:8080/keycloak"
    },
    "DataGateway": {
      "BaseUrl": "http://192.168.20.20:5010",
      "ApiVersion": "v1"
    },
    "MngNotifiers": {
      "Enabled": true,
      "BaseUrl": "http://192.168.20.20:5070",
      "ApiVersion": "v1",
      "EmailDomainSuffix": null
    },
    "RabbitMq": {
      "Host": "192.168.20.20",
      "Port": 5672,
      "Username": "admin",
      "Password": "Odak@Infra2026!",
      "VirtualHost": "/",
      "Exchange": "oc.events"
    },
    "MetadataCache": {
      "TtlSeconds": 120
    }
  }
}
