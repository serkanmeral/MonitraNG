{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "MngOperations": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "MngOperations.Api",
      "Environment": "Development"
    }
  },
  "AllowedHosts": "*",
  "EnableSwagger": true,
  "Jwt": {
    "Authority": "",
    "RequireHttpsMetadata": false
  },
  "MngOperationsSettings": {
    "Server": {
      "Host": "0.0.0.0",
      "Port": 5086,
      "Scheme": "http"
    },
    "OpenApiServerPath": "https://api.monitra.local/operations",
    "Actors": {
      "MngKeeper": "http://localhost:5001",
      "KeycloakBaseUrl": "http://localhost:8080/keycloak"
    },
    "DataGateway": {
      "BaseUrl": "http://localhost:5010",
      "ApiVersion": "v1",
      "TimeoutSeconds": 30,
      "RetryCount": 3,
      "RetryBaseDelayMs": 200
    },
    "MngNotifiers": {
      "BaseUrl": "http://localhost:5070"
    },
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "Username": "admin",
      "Password": "admin123",
      "VirtualHost": "/",
      "Exchange": "oc.events"
    },
    "MetadataCache": {
      "TtlSeconds": 120
    }
  }
}
