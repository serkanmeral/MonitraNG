{
  "packageId": "siem-product-v3",
  "packageVersion": "3.0.0",
  "templates": [
    { "templateId": "U1", "name": "U1 Threshold", "severity": 7, "definition": { "schemaVersion": 3, "graph": { "nodes": [ { "id": "source", "type": "source", "config": { "source": { "kind": "observation", "matchKey": "u1" } } }, { "id": "decision", "type": "decision", "config": { "condition": { "field": "value", "operator": "gte", "value": 1 } } }, { "id": "alarm", "type": "alarm-output", "config": { "severity": 7, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}:{groupKey}", "cooldownSeconds": 60 } } }, { "id": "stop", "type": "stop-output", "config": {} } ], "edges": [ { "id": "e1", "from": "source", "to": "decision", "fromPort": "next", "toPort": "in" }, { "id": "e2", "from": "decision", "to": "alarm", "fromPort": "true", "toPort": "in" }, { "id": "e3", "from": "decision", "to": "stop", "fromPort": "false", "toPort": "in" } ] } } },
    { "templateId": "U2", "name": "U2 Sequence", "severity": 8, "definition": { "schemaVersion": 3, "graph": { "nodes": [ { "id": "a", "type": "source", "config": { "source": { "matchKey": "u2.a" } } }, { "id": "b", "type": "source", "config": { "source": { "matchKey": "u2.b" } } }, { "id": "sequence", "type": "sequence", "config": { "sequence": { "steps": [ { "matchKey": "u2.a", "minCount": 1, "withinSeconds": 60 }, { "matchKey": "u2.b", "minCount": 1, "withinSeconds": 60 } ] } } }, { "id": "alarm", "type": "alarm-output", "config": { "severity": 8, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}", "cooldownSeconds": 60 } } }, { "id": "stop", "type": "stop-output", "config": {} } ], "edges": [ { "id": "e1", "from": "a", "to": "sequence", "fromPort": "next", "toPort": "in" }, { "id": "e2", "from": "b", "to": "sequence", "fromPort": "next", "toPort": "in" }, { "id": "e3", "from": "sequence", "to": "alarm", "fromPort": "true", "toPort": "in" }, { "id": "e4", "from": "sequence", "to": "stop", "fromPort": "false", "toPort": "in" } ] } } },
    { "templateId": "U3", "name": "U3 Filter", "severity": 6, "definition": { "schemaVersion": 3, "graph": { "nodes": [ { "id": "source", "type": "source", "config": { "source": { "matchKey": "u3" } } }, { "id": "filter", "type": "filter", "config": { "condition": { "field": "dimensions.allowed", "operator": "eq", "value": true } } }, { "id": "alarm", "type": "alarm-output", "config": { "severity": 6, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}:{key}", "cooldownSeconds": 30 } } }, { "id": "stop", "type": "stop-output", "config": {} } ], "edges": [ { "id": "e1", "from": "source", "to": "filter", "fromPort": "next", "toPort": "in" }, { "id": "e2", "from": "filter", "to": "alarm", "fromPort": "true", "toPort": "in" }, { "id": "e3", "from": "filter", "to": "stop", "fromPort": "false", "toPort": "in" } ] } } },
    { "templateId": "U4", "name": "U4 Aggregation", "severity": 7, "definition": { "schemaVersion": 3, "graph": { "nodes": [ { "id": "source", "type": "source", "config": { "source": { "matchKey": "u4" } } }, { "id": "threshold", "type": "threshold", "config": { "aggregation": { "function": "count", "operator": "gte", "threshold": 2 }, "window": { "durationSeconds": 300 }, "settleAfterSeconds": 10 } }, { "id": "alarm", "type": "alarm-output", "config": { "severity": 7, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}:{groupKey}", "cooldownSeconds": 60 } } }, { "id": "stop", "type": "stop-output", "config": {} } ], "edges": [ { "id": "e1", "from": "source", "to": "threshold", "fromPort": "next", "toPort": "in" }, { "id": "e2", "from": "threshold", "to": "alarm", "fromPort": "true", "toPort": "in" }, { "id": "e3", "from": "threshold", "to": "stop", "fromPort": "false", "toPort": "in" } ] } } },
    { "templateId": "U5", "name": "U5 Decision", "severity": 5, "definition": { "schemaVersion": 3, "graph": { "nodes": [ { "id": "source", "type": "source", "config": { "source": { "matchKey": "u5" } } }, { "id": "decision", "type": "decision", "config": { "condition": { "field": "kind", "operator": "eq", "value": "security" } } }, { "id": "high", "type": "alarm-output", "config": { "severity": 9, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}", "cooldownSeconds": 60 } } }, { "id": "low", "type": "alarm-output", "config": { "severity": 5, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}", "cooldownSeconds": 60 } } } ], "edges": [ { "id": "e1", "from": "source", "to": "decision", "fromPort": "next", "toPort": "in" }, { "id": "e2", "from": "decision", "to": "high", "fromPort": "true", "toPort": "in" }, { "id": "e3", "from": "decision", "to": "low", "fromPort": "false", "toPort": "in" } ] } } },
    { "templateId": "U6", "name": "U6 Branch", "severity": 6, "definition": { "schemaVersion": 3, "graph": { "nodes": [ { "id": "source", "type": "source", "config": { "source": { "matchKey": "u6" } } }, { "id": "decision", "type": "decision", "config": { "condition": { "field": "value", "operator": "gt", "value": 10 } } }, { "id": "alarm1", "type": "alarm-output", "config": { "severity": 8, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}", "cooldownSeconds": 0 } } }, { "id": "alarm2", "type": "alarm-output", "config": { "severity": 6, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}", "cooldownSeconds": 0 } } } ], "edges": [ { "id": "e1", "from": "source", "to": "decision", "fromPort": "next", "toPort": "in" }, { "id": "e2", "from": "decision", "to": "alarm1", "fromPort": "true", "toPort": "in" }, { "id": "e3", "from": "decision", "to": "alarm2", "fromPort": "true", "toPort": "in" } ] } } },
    { "templateId": "U7", "name": "U7 Condition", "severity": 7, "definition": { "schemaVersion": 3, "graph": { "nodes": [ { "id": "source", "type": "source", "config": { "source": { "matchKey": "u7" } } }, { "id": "condition", "type": "condition", "config": { "condition": { "field": "dimensions.user", "operator": "exists", "value": true } } }, { "id": "alarm", "type": "alarm-output", "config": { "severity": 7, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}:{groupKey}", "cooldownSeconds": 120 }, "groupBy": [ "user" ] } } ], "edges": [ { "id": "e1", "from": "source", "to": "condition", "fromPort": "next", "toPort": "in" }, { "id": "e2", "from": "condition", "to": "alarm", "fromPort": "true", "toPort": "in" } ] } } },
    { "templateId": "U8", "name": "U8 Stop", "severity": 4, "definition": { "schemaVersion": 3, "graph": { "nodes": [ { "id": "source", "type": "source", "config": { "source": { "matchKey": "u8" } } }, { "id": "filter", "type": "filter", "config": { "condition": { "field": "value", "operator": "gte", "value": 1 } } }, { "id": "alarm", "type": "alarm-output", "config": { "severity": 4, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}", "cooldownSeconds": 10 } } }, { "id": "stop", "type": "stop-output", "config": {} } ], "edges": [ { "id": "e1", "from": "source", "to": "filter", "fromPort": "next", "toPort": "in" }, { "id": "e2", "from": "filter", "to": "alarm", "fromPort": "true", "toPort": "in" }, { "id": "e3", "from": "filter", "to": "stop", "fromPort": "false", "toPort": "in" } ] } } },
    { "templateId": "U9", "name": "U9 Multi Output", "severity": 8, "definition": { "schemaVersion": 3, "graph": { "nodes": [ { "id": "source", "type": "source", "config": { "source": { "matchKey": "u9" } } }, { "id": "decision", "type": "decision", "config": { "condition": { "field": "value", "operator": "gte", "value": 1 } } }, { "id": "alarmA", "type": "alarm-output", "config": { "severity": 8, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}", "cooldownSeconds": 60 } } }, { "id": "alarmB", "type": "alarm-output", "config": { "severity": 9, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}", "cooldownSeconds": 300 } } } ], "edges": [ { "id": "e1", "from": "source", "to": "decision", "fromPort": "next", "toPort": "in" }, { "id": "e2", "from": "decision", "to": "alarmA", "fromPort": "true", "toPort": "in" }, { "id": "e3", "from": "decision", "to": "alarmB", "fromPort": "true", "toPort": "in" } ] } } },
    { "templateId": "U10", "name": "U10 Timeout", "severity": 9, "definition": { "schemaVersion": 3, "graph": { "nodes": [ { "id": "start", "type": "source", "config": { "source": { "matchKey": "u10.start" } } }, { "id": "finish", "type": "source", "config": { "source": { "matchKey": "u10.finish" } } }, { "id": "sequence", "type": "sequence", "config": { "sequence": { "steps": [ { "matchKey": "u10.start", "minCount": 1, "withinSeconds": 30 }, { "matchKey": "u10.finish", "minCount": 1, "withinSeconds": 30 } ] } } }, { "id": "alarm", "type": "alarm-output", "config": { "severity": 9, "dedup": { "keyTemplate": "{scenarioId}:{outputNodeId}:{groupKey}", "cooldownSeconds": 60 } } }, { "id": "stop", "type": "stop-output", "config": {} } ], "edges": [ { "id": "e1", "from": "start", "to": "sequence", "fromPort": "next", "toPort": "in" }, { "id": "e2", "from": "finish", "to": "sequence", "fromPort": "next", "toPort": "in" }, { "id": "e3", "from": "sequence", "to": "alarm", "fromPort": "true", "toPort": "in" }, { "id": "e4", "from": "sequence", "to": "stop", "fromPort": "false", "toPort": "in" } ] } } }
  ]
}
