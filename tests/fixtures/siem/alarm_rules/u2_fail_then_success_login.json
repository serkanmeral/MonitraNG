{
  "name": "U2 — Fail→success login (hedef)",
  "type": "sequence",
  "matchKey": "login_success_after_failures",
  "groupByFields": ["userId", "srcIp"],
  "windowMinutes": 15,
  "threshold": 1,
  "severity": 8,
  "cooldownMinutes": 60,
  "dedupKeyTemplate": "{ruleId}:{groupKey}",
