{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnableSwagger": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "MngLogCollectorSettings": {
    "Server": {
      "Host": "0.0.0.0",
      "Port": 5091,
      "Scheme": "http"
    },
    "OpenSearch": {
      "Url": "http://localhost:9200",
      "WriteEnabled": true
    },
    "Ingest": {
      "ApiKey": "",
      "MaxEventsPerBatch": 500
    },
    "MongoDB": {
      "ConnectionString": "mongodb://admin:admin123@localhost:27017",
      "KeeperDatabaseName": "mngkeeper",
      "EventLogCatalogDatabaseName": "mng_odak"
    },
    "Discovery": {
      "Prefixes": [
        { "Cidr": "192.168.20.0/24", "Label": "Odak ofis" }
      ]
    },
    "AgentPackages": {
      "Directory": "/var/lib/mnglogcollector/agent-packages",
      "PublicBaseUrl": ""
    }
  }
}
