# Mng.Ui — yerel geliştirme / ortam örneği
# Kopyalayın: cp .env.example .env

# --- Odak sunucu (önerilen: yerel UI → sunucu Gateway/Keeper) ---
GATEWAY_URL=http://192.168.20.20:5040
HUB_URL=http://192.168.20.20:5020
# GATEWAY_URL tanımlıyken KEEPER_URL / DATAGATEWAY_URL kullanılmaz (proxy /keeper/api/...)

# --- Yerel backend (yalnızca tüm stack localhost'ta çalışıyorsa) ---
# GATEWAY_URL=https://localhost:5040
# HUB_URL=http://localhost:5020
# DATAGATEWAY_URL=https://localhost:5010
# KEEPER_URL=https://localhost:5001

# GeoServer — harita sayfası çevrimdışı altlık (Monitoring > Harita)
# Tanımlıysa "GeoServer arka plan" seçeneği görünür; tile istekleri /api/tiles/geoserver üzerinden proxy edilir.
GEOSERVER_BASE_URL=http://localhost:8082

# Opsiyonel: GeoServer WMTS tile matrix set (varsayılan: EPSG:900913)
# GeoServer'da sadece EPSG:3857 varsa: GEOSERVER_TILE_MATRIX_SET=EPSG:3857
# GEOSERVER_TILE_MATRIX_SET=EPSG:900913

# Opsiyonel: Grid subset sınırlıysa Leaflet (x,y) ile GeoServer (tilecol,tilerow) hizası için ofset
# Doküman: ApplicationResources/mng_others/GEOSERVER_GRIDSET_EPSG3857.md
# GEOSERVER_TILE_COL_OFFSET=0
# GEOSERVER_TILE_ROW_OFFSET=0
