# Mng.Ui — yerel geliştirme → Production Odak (192.168.20.8)
# Kullanım: cp .env.odak.prod.example .env
# Doküman: docs/odak/proddeploy/ENVIRONMENTS.md

ODAK_HOST=192.168.20.8

GATEWAY_URL=http://192.168.20.8:5040
HUB_URL=http://192.168.20.8:5020

SCHEDULER_URL=http://192.168.20.8:5090
ADMIN_URL=http://192.168.20.8:5080
# MngLogCollector (SIEM ayarları → Katalog). Boş bırakılırsa ODAK_HOST:5091 kullanılır.
# LOGCOLLECTOR_URL=http://192.168.20.8:5091
# Collector Ingest ApiKey doluysa Nuxt BFF için (repoya yazmayın; .env yerel):
# MNGLOGCOLLECTOR_INGEST_API_KEY=

# Opsiyonel — harita altlığı (Monitoring > Harita)
# GEOSERVER_BASE_URL=http://192.168.20.8:8082
